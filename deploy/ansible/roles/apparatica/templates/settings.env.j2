# {{ ansible_managed }}
# Settings of deploy/compose.yaml and compose.server.yaml on this host; secrets are in secrets.env.
SITE_HOST={{ apparatica_site_host }}
S3_HOST={{ apparatica_s3_host }}
WAVEVIEW_HOST={{ apparatica_waveview_host }}
APX_ENVIRONMENT=production
APX_COOKIE_SECURE=true
MAIL_FROM="{{ apparatica_mail_from }}"
SANDBOX_RUNTIME=runsc
GARAGE_CAPACITY_GB={{ apparatica_garage_capacity_gb }}
POSTGRES_ARCHIVE_MODE={{ 'on' if apparatica_backups else 'off' }}
{% if apparatica_alert_telegram_chat_id | string %}
TELEGRAM_CHAT_ID={{ apparatica_alert_telegram_chat_id }}
{% endif %}
{% if apparatica_backup_s3_url %}
BACKUP_S3_URL={{ apparatica_backup_s3_url }}
BACKUP_S3_REGION={{ apparatica_backup_s3_region }}
BACKUP_S3_BUCKET={{ apparatica_backup_s3_bucket }}
{% endif %}
