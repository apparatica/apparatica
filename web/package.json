  "type": "module",
  "scripts": {
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "api:generate": "openapi-typescript ../backend/openapi.json --output src/lib/api/schema.d.ts",
