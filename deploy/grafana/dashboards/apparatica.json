    {
      "type": "timeseries",
      "id": 12,
      "title": "Доля internal_error по этапам",
      "description": "Этапы со статусом error среди запущенных (без skipped); 0, пока ошибок нет. Основа алерта NFR-OBS-04.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (stage) (rate(apparatica_worker_stages_total{status=\"error\"}[$__rate_interval])) or 0 * sum by (stage) (rate(apparatica_worker_stages_total[$__rate_interval]))) / sum by (stage) (rate(apparatica_worker_stages_total{status!=\"skipped\"}[$__rate_interval]))",
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
