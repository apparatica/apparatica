# Settings of deploy/compose.yaml. Copy to deploy/.env (ignored by git) and change what you need;
# unset values take the defaults of compose.yaml.
#
# The defaults of the secrets are public development values. Generate new ones for any stand that
# others can reach:  openssl rand -hex 32  (Garage key ids: "GK" + openssl rand -hex 12).

# Port of the site on the host: http://localhost:8080
HTTP_PORT=8080
# Secure guest cookie: true when the stand is served over HTTPS
APX_COOKIE_SECURE=false

# Secrets
POSTGRES_PASSWORD=apparatica
APX_JOB_TOKEN_KEY=d0bcee91e1bd0d6ae13d2a129c5f78bc14b19f28c6824598c54dbc3b5ca20531
