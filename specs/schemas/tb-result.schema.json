{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apparatica.app/schemas/tb-result/1.json",
  "title": "Apparatica testbench result record (one JSON Lines record)",
  "type": "object",
  "required": [
    "v",
    "event"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "event": {
      "enum": [
        "suite_start",
        "test_start",
        "mismatch",
        "test_end",
        "suite_end"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "suite_start"
          }
        }
      },
      "then": {
        "required": [
          "seed",
          "groups",
          "tests_total"
        ],
        "properties": {
          "seed": {
            "type": "integer"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tests_total": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "test_start"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "name",
          "group",
          "cycle"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "cycle": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "mismatch"
          }
        }
      },
      "then": {
        "required": [
          "test",
          "cycle",
          "signal",
          "expected",
          "actual"
        ],
        "properties": {
          "test": {
            "type": "string"
          },
          "cycle": {
            "type": "integer",
            "minimum": 0
          },
          "time_ps": {
            "type": "integer",
            "minimum": 0
          },
          "signal": {
            "type": "string"
          },
          "expected": {
            "type": "string",
            "pattern": "^[0-9]+'[bhd][0-9a-fA-F_]+$"
          },
          "actual": {
            "type": "string",
            "pattern": "^[0-9]+'[bhd][0-9a-fA-F_]+$"
          },
          "hint": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "test_end"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "status",
          "cycle"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed"
            ]
          },
          "cycles": {
            "type": "integer",
            "minimum": 0
          },
          "cycle": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "suite_end"
          }
        }
      },
      "then": {
        "required": [
          "passed",
          "failed",
          "not_run",
          "cycles"
        ],
        "properties": {
          "passed": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "not_run": {
            "type": "integer",
            "minimum": 0
          },
          "cycles": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  ]
}
