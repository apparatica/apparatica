          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Итоги проверок в минуту",
      "description": "Финальные статусы от ингестора и попытки, в которых пайплайн не запустился (код ошибки).",
