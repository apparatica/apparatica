# Reverse proxy of the stand (specs/03 §2): the site and the API on one origin, the object storage
# and the waveview website on their own. HTTP only: TLS and the production domains come with
# staging (T1.23).
{
	admin off
	auto_https off
}

http://localhost {
	# The API, unbuffered: server-sent events of submissions arrive as they are written (Ф1).
	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}

# S3 API for presigned URLs of artifacts; the Host header is kept, it is part of the signature.
http://s3.localhost {
	reverse_proxy garage:3900
}

# The waveview bucket as a website: Surfer on its own origin, embedded by the site in an isolated
# frame (ADR-0004, docs/waveview.md). The frame has the opaque origin "null", so its module and WASM
# are CORS requests; some antivirus software adds headers to them, which needs an answer to OPTIONS.
http://waveview.web.localhost {
	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		header Access-Control-Allow-Headers *
		respond 204
	}
	handle {
		encode zstd gzip
		reverse_proxy garage:3902
	}
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; connect-src 'self'; img-src 'self' data: blob:; font-src 'self'; frame-ancestors {$SITE_ORIGIN}"
		Access-Control-Allow-Origin *
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	# A published version never changes (waveview/versions.lock).
	@versioned path_regexp ^/\d{4}\.\d+\.\d+/
	header @versioned Cache-Control "public, max-age=31536000, immutable"
}
