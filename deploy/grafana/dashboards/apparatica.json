          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(apparatica_worker_attempts_total{outcome!~\"done|cancelled\"}[$__rate_interval])) * 60",
          "legendFormat": "не запустилась: {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
