  "code": "module counter_mod_n #(\n  parameter int N = 10\n) (\n  input  logic                 clk,\n  input  logic                 rst,\n  input  logic                 en,\n  output logic [$clog2(N)-1:0] count,\n  output logic                 wrap\n);\n  localparam int W = $clog2(N);\n  localparam logic [W-1:0] LAST = W'(N - 1);\n\n  assign wrap = en && count == LAST;\n\n  always_ff @(posedge clk)\n    if (rst) count <= #1 '0;\n    else if (wrap) count <= #1 '0;\n    else if (en) count <= #1 count + 1'b1;\nendmodule\n",
